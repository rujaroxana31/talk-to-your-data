{
  "name": "talk-to-your-data",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --experimental-strip-types --test tests/security.unit.test.mjs tests/worker.test.mjs tests/api.test.mjs",
    "worker:dev": "wrangler dev --ip 127.0.0.1 --port 8787",
    "worker:check": "wrangler deploy --dry-run --outdir dist/worker",
    "worker:compare": "wrangler dev scripts/compare-retrieval.ts --ip 127.0.0.1 --port 8788",
    "worker:test:http": "node --test tests/worker-http.test.mjs",
    "test:browser": "node tests/security.browser.mjs",
    "test:golden": "node scripts/run-golden.mjs"
  },
  "dependencies": {
    "@duckdb/duckdb-wasm": "^1.33.1-dev57.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "wrangler": "^4.155.0"
  }
}
